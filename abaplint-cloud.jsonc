// The ABAP Cloud check (npm run lint:cloud, part of npm run check): the
// build of the branch cloud (build/cloud, written by scripts/cloud.mjs just
// before - src/ with the files of cloud/ in place, z2ui5_cl_rap_platform
// above all) against the ABAP Cloud language version and the released API
// set alone - errorNamespace "." makes every SAP object that is not in the
// steampunk-2305 API set an error, where abaplint.jsonc (^Z) treats it as
// void. What it shows: no static reference to an on-premise object is left
// in what the branch cloud carries. A name in a literal of a dynamic
// statement it cannot see - the ABAP Cloud syntax check in a system reports
// those too, so scripts/cloud.mjs looks for them by name. What neither
// shows: whether a method of a released class is released itself, the
// system fields an ABAP Cloud syntax check warns about - see README "ABAP
// Cloud" and ROADMAP.md. Style rules stay in abaplint.jsonc; this file
// checks syntax and the API set only.
{
  "global": {
    "files": "/build/cloud/src/**/*.*",
    // the dynamic EML statements abaplint cannot parse - as in abaplint.jsonc
    "noIssues": [
      "/build/cloud/src/z2ui5_cl_rap_eml_perm.clas.abap",
      "/build/cloud/src/z2ui5_cl_rap_eml_read.clas.abap",
      "/build/cloud/src/z2ui5_cl_rap_eml_key.clas.abap"
    ]
  },
  "dependencies": [
    {
      "url": "https://github.com/abapedia/steampunk-2305-api",
      "folder": "/deps",
      "files": "/src/**/*.*"
    },
    {
      // the same release as abaplint.jsonc - scripts/core-pin.mjs moves both
      "url": "https://github.com/abap2UI5/abap2UI5",
      "branch": "1.151.0",
      "folder": "/abap2UI5",
      "files": "/src/**/*.*"
    }
  ],
  "syntax": {
    "version": "Cloud",
    "errorNamespace": "."
  },
  "rules": {
    "check_syntax": true,
    "parser_error": true,
    "unknown_types": true,
    "cloud_types": true,
    "check_ddic": true,
    "xml_consistency": true
  }
}
