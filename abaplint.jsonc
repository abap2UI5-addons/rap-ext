{
  "global": {
    "files": "/src/**/*.*"
  },
  "dependencies": [
    {
      "url": "https://github.com/abapedia/steampunk-2305-api",
      "folder": "/deps",
      "files": "/src/**/*.*"
    },
    {
      "url": "https://github.com/abap2UI5/abap2UI5",
      "folder": "/abap2UI5",
      "files": "/src/**/*.*"
    }
  ],
  "syntax": {
    "version": "v758",
    // ^Z (not "."): the wrapper reads CDS annotations via on-prem DDIC APIs
    // (cl_dd_ddl_annotation_service, DDSTRUCOBJNAME) that the steampunk-2305
    // dependency does not ship - with "." every one of them is a false
    // "not found" error. ^Z keeps the own namespace fully checked and treats
    // unknown SAP-standard objects as void, which matches the on-prem target.
    "errorNamespace": "^Z"
  },
  "rules": {
    "downport": true,
    "begin_end_names": true,
    "check_ddic": true,
    "check_include": true,
    "check_syntax": true,
    "global_class": true,
    "definitions_top": false,
    "implement_methods": true,
    "method_implemented_twice": true,
    "parser_error": true,
    "superclass_final": true,
    "unknown_types": true,
    "xml_consistency": true
  }
}
